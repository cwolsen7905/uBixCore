<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{block title}Sowing.me{/block} | Planting. Believing. Thriving.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        /* ============================================================
           Sowing.me — design tokens (synced from the Marketing Site
           Claude Design project, 2026-08-28). Values map 1:1 to the
           design-system @theme namespaces. See design-system.md.
           ============================================================ */
        :root {
            /* brand green */
            --color-brand-50:#E8F5E9; --color-brand-100:#C8E6C9; --color-brand-200:#A5D6A7;
            --color-brand-300:#81C784; --color-brand-400:#66BB6A; --color-brand-500:#4CAF50;
            --color-brand-600:#2E7D32; --color-brand-700:#257029; --color-brand-800:#1B5E20; --color-brand-900:#14481A;
            /* blue */
            --color-blue-50:#E3F2FD; --color-blue-100:#BBDEFB; --color-blue-300:#64B5F6;
            --color-blue-500:#2196F3; --color-blue-700:#1565C0; --color-blue-900:#0D47A1;
            /* accent orange (retired from CTAs in this pass) */
            --color-accent-50:#FFF3E0; --color-accent-300:#FFB74D; --color-accent-500:#FF8F00; --color-accent-700:#F57C00;
            /* neutral blue-grey */
            --color-slate-50:#F5F7F8; --color-slate-100:#ECEFF1; --color-slate-200:#CFD8DC;
            --color-slate-300:#B0BEC5; --color-slate-400:#90A4AE; --color-slate-500:#78909C;
            --color-slate-600:#546E7A; --color-slate-700:#455A64; --color-slate-800:#37474F; --color-slate-900:#263238;
            /* semantic */
            --color-primary:#2E7D32; --color-primary-hover:#1B5E20; --color-primary-soft:#E8F5E9;
            --color-secondary:#1565C0; --color-secondary-hover:#0D47A1;
            --color-accent:#FF8F00; --color-accent-hover:#F57C00;
            --color-surface:#FFFFFF; --color-surface-2:#F5F7F8; --color-border:#CFD8DC;
            --color-text:#263238; --color-text-muted:#546E7A; --color-text-subtle:#78909C;
            --color-on-primary:#FFFFFF; --color-success:#2E7D32; --color-danger:#E5484D;
            /* legacy aliases kept for any un-migrated consumer */
            --color-primary-dark:#1B5E20; --color-dark:#263238; --color-light:#F5F5F5; --color-white:#FFFFFF;
            /* type */
            --font-heading:'Inter',system-ui,sans-serif; --font-body:'Open Sans',system-ui,sans-serif;
            --text-xs:.75rem; --text-sm:.875rem; --text-base:1rem; --text-lg:1.125rem;
            --text-xl:1.375rem; --text-2xl:1.75rem; --text-3xl:2.125rem; --text-4xl:3rem;
            /* spacing / radii / elevation */
            --spacing-1:.25rem; --spacing-2:.5rem; --spacing-3:.75rem; --spacing-4:1rem;
            --spacing-6:1.5rem; --spacing-8:2rem; --spacing-12:3rem;
            --radius-sm:.25rem; --radius-md:6px; --radius-lg:12px; --radius-xl:16px; --radius-full:9999px;
            --shadow-sm:0 1px 2px rgba(38,50,56,.08); --shadow-card:0 2px 4px rgba(38,50,56,.10); --shadow-lg:0 12px 32px rgba(38,50,56,.14);
        }

        /* ---- shared page language (site.css) ---- */
        *{box-sizing:border-box}
        body{margin:0;background:var(--color-surface);color:var(--color-text);font-family:var(--font-body);font-size:1.0625rem;line-height:1.65;-webkit-font-smoothing:antialiased;text-wrap:pretty}
        h1,h2,h3,h4{font-family:var(--font-heading);color:var(--color-text);margin:0}
        p{margin:0}
        a{color:var(--color-primary);text-decoration:none}
        a:hover{color:var(--color-primary-hover)}
        img{display:block}
        .wrap{max-width:1120px;margin:0 auto;padding:0 48px}
        .section{padding:112px 0}
        .section-sm{padding:80px 0}
        .tint{background:var(--color-surface-2)}
        .rule{height:1px;background:var(--color-slate-100)}
        .display{font-size:3.5rem;font-weight:800;line-height:1.02;letter-spacing:-.038em}
        .h2{font-size:2.5rem;font-weight:800;line-height:1.1;letter-spacing:-.03em}
        .h3{font-size:1.1875rem;font-weight:700;line-height:1.35;letter-spacing:-.015em}
        .h1{font-size:3rem;font-weight:800;line-height:1.08;letter-spacing:-.033em}
        .eyebrow{display:inline-block;font-family:var(--font-heading);font-size:.75rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--color-primary)}
        .lede{font-size:1.25rem;line-height:1.55;color:var(--color-text-muted)}
        .body-muted{color:var(--color-text-muted)}
        .small{font-size:.9375rem;line-height:1.55;color:var(--color-text-muted)}
        .micro{font-family:var(--font-heading);font-size:.8125rem;font-weight:600;letter-spacing:.02em;color:var(--color-text-subtle)}
        .section-head{max-width:620px}
        .section-head .h2{margin:14px 0 16px}
        .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:var(--font-heading);font-weight:700;font-size:1rem;padding:14px 26px;border-radius:var(--radius-md);border:1px solid transparent;cursor:pointer;transition:background .15s ease,border-color .15s ease,box-shadow .15s ease,transform .15s ease,color .15s ease}
        .btn-primary{background:var(--color-primary);color:#fff;box-shadow:0 1px 2px rgba(27,94,32,.24)}
        .btn-primary:hover{background:var(--color-primary-hover);color:#fff;box-shadow:0 4px 14px rgba(27,94,32,.26);transform:translateY(-1px)}
        .btn-ghost{background:#fff;border-color:var(--color-border);color:var(--color-text)}
        .btn-ghost:hover{background:var(--color-slate-50);border-color:var(--color-slate-400);color:var(--color-text)}
        .btn-light{background:#fff;color:var(--color-text)}
        .btn-light:hover{background:var(--color-slate-100);color:var(--color-text);transform:translateY(-1px)}
        .btn-onDark{background:transparent;border-color:rgba(255,255,255,.4);color:#fff}
        .btn-onDark:hover{background:rgba(255,255,255,.1);border-color:#fff;color:#fff}
        .btn-row{display:flex;gap:12px;flex-wrap:wrap}
        .arrow-link{display:inline-flex;align-items:center;gap:7px;font-family:var(--font-heading);font-weight:700;font-size:.9375rem;color:var(--color-primary)}
        .arrow-link svg{width:15px;height:15px;transition:transform .15s ease}
        .arrow-link:hover svg{transform:translateX(3px)}
        .card{background:#fff;border:1px solid var(--color-slate-100);border-radius:14px;padding:30px;transition:border-color .18s ease,box-shadow .18s ease,transform .18s ease}
        .card:hover{border-color:var(--color-slate-200);box-shadow:0 8px 24px rgba(38,50,56,.07);transform:translateY(-2px)}
        .card .h3{margin-bottom:8px}
        .card p{color:var(--color-text-muted);font-size:.9375rem;line-height:1.6}
        .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
        .grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
        .icon-tile{width:40px;height:40px;border-radius:10px;background:var(--color-brand-50);display:flex;align-items:center;justify-content:center;margin-bottom:18px}
        .icon-tile svg{width:20px;height:20px;stroke:var(--color-primary);fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}
        .frame{border:1px solid var(--color-slate-100);border-radius:16px;overflow:hidden;box-shadow:0 24px 60px rgba(38,50,56,.10)}
        .img-ph{width:100%;height:100%;min-height:260px;background:var(--color-surface-2);display:flex;align-items:center;justify-content:center;text-align:center;padding:20px;color:var(--color-text-subtle);font-family:var(--font-heading);font-size:.8125rem;font-weight:600;letter-spacing:.02em}
        .band{background:var(--color-slate-900);color:#fff}
        .band .h2,.band h3{color:#fff}
        .cta-band{background:var(--color-primary);color:#fff;padding:96px 0}
        .cta-band .h2{color:#fff}
        .cta-band p{color:rgba(255,255,255,.86);max-width:520px}
        .cta-band .btn-row{flex-wrap:nowrap;flex-shrink:0}
        .page-hero{background:linear-gradient(180deg,#F2F7F2 0%,#fff 100%);padding:76px 0 68px;border-bottom:1px solid var(--color-slate-100)}
        .page-hero .h1{margin:14px 0 18px;max-width:14em}
        .page-hero .lede{max-width:600px}
        .page-hero .btn-row{margin-top:30px}
        ul.checks{list-style:none;padding:0;margin:22px 0 0}
        ul.checks li{position:relative;padding:9px 0 9px 30px;font-size:.9375rem;color:var(--color-text)}
        ul.checks li svg{position:absolute;left:0;top:14px;width:16px;height:16px;stroke:var(--color-primary);stroke-width:3;fill:none;stroke-linecap:round}
        .panel{border:1px solid var(--color-slate-100);border-radius:16px;background:#fff}
        table.cmp{width:100%;border-collapse:collapse}
        table.cmp th,table.cmp td{padding:16px 24px;text-align:left;font-size:.9375rem;border-bottom:1px solid var(--color-slate-100)}
        table.cmp thead th{background:var(--color-surface-2);font-family:var(--font-heading);font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--color-text-muted)}
        table.cmp tbody th{font-family:var(--font-heading);font-weight:600;color:var(--color-text)}
        table.cmp td{color:var(--color-text-muted)}
        table.cmp tr:last-child th,table.cmp tr:last-child td{border-bottom:none}
        table.cmp .yes{color:var(--color-primary);font-weight:700}
        table.cmp .no{color:var(--color-slate-300)}
        .faq{display:grid;grid-template-columns:1fr 1fr;gap:0 56px;margin-top:44px}
        .faq-item{padding:26px 0;border-top:1px solid var(--color-slate-100)}
        .faq-item h4{font-family:var(--font-heading);font-size:1rem;font-weight:700;letter-spacing:-.01em;margin-bottom:7px}
        .faq-item p{color:var(--color-text-muted);font-size:.9375rem}

        /* ---- shared header (header.css) ---- */
        .site-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.86);-webkit-backdrop-filter:saturate(1.6) blur(14px);backdrop-filter:saturate(1.6) blur(14px);border-bottom:1px solid var(--color-slate-100);transition:box-shadow .2s ease,border-color .2s ease}
        .site-header[data-scrolled]{border-color:var(--color-border);box-shadow:0 1px 12px rgba(38,50,56,.08)}
        .site-header .nav-row{max-width:1120px;margin:0 auto;padding:0 48px;height:74px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:32px}
        .site-header .brand{display:flex;align-items:center;gap:9px;justify-self:start;border-radius:var(--radius-md)}
        .site-header .brand img{height:38px;width:38px;object-fit:contain}
        .site-header .brand span{font-family:var(--font-heading);font-weight:800;font-size:1.25rem;letter-spacing:-.02em;color:var(--color-primary)}
        .site-header .brand:hover span{color:var(--color-primary-hover)}
        .site-header nav.links{display:flex;gap:6px;justify-self:center}
        .site-header nav.links a{position:relative;display:flex;align-items:center;height:74px;padding:0 14px;color:var(--color-text-muted);font-family:var(--font-heading);font-weight:600;font-size:.9375rem;letter-spacing:-.005em;transition:color .15s ease}
        .site-header nav.links a::after{content:"";position:absolute;left:14px;right:14px;bottom:-1px;height:2px;border-radius:2px;background:var(--color-primary);transform:scaleX(0);transform-origin:center;transition:transform .18s ease}
        .site-header nav.links a:hover{color:var(--color-text)}
        .site-header nav.links a:hover::after{transform:scaleX(.55)}
        .site-header nav.links a[aria-current="page"]{color:var(--color-primary)}
        .site-header nav.links a[aria-current="page"]::after{transform:scaleX(1)}
        .site-header .nav-actions{display:flex;align-items:center;gap:8px;justify-self:end}
        .site-header .nav-login{padding:10px 14px;border-radius:var(--radius-md);color:var(--color-text-muted);font-family:var(--font-heading);font-weight:600;font-size:.9375rem;transition:color .15s ease,background .15s ease}
        .site-header .nav-login:hover{color:var(--color-text);background:var(--color-slate-50)}
        .site-header .nav-signup{padding:11px 22px;border-radius:var(--radius-md);background:var(--color-primary);color:var(--color-on-primary);font-family:var(--font-heading);font-weight:700;font-size:.9375rem;box-shadow:0 1px 2px rgba(27,94,32,.24);transition:background .15s ease,box-shadow .15s ease,transform .15s ease}
        .site-header .nav-signup:hover{background:var(--color-primary-hover);box-shadow:0 3px 10px rgba(27,94,32,.26);transform:translateY(-1px)}
        .site-header a{text-decoration:none}
        .site-header a:focus-visible{outline:2px solid var(--color-primary);outline-offset:2px}

        /* ---- shared footer (site.css) ---- */
        footer.site-footer{background:var(--color-slate-900);color:var(--color-slate-300);padding:72px 0 28px;font-size:.9375rem}
        .site-footer .f-top{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:40px}
        .site-footer .f-brand{display:flex;align-items:center;gap:9px}
        .site-footer .f-brand span{font-family:var(--font-heading);font-weight:800;font-size:1.25rem;letter-spacing:-.02em;color:#fff}
        .site-footer .f-blurb{color:var(--color-slate-400);font-size:.875rem;max-width:260px;margin-top:16px}
        .site-footer h4{color:#fff;font-family:var(--font-heading);font-size:.8125rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:16px}
        .site-footer a{display:block;color:var(--color-slate-300);font-size:.9375rem;padding:5px 0}
        .site-footer a:hover{color:#fff}
        .site-footer .f-bottom{border-top:1px solid var(--color-slate-800);margin-top:56px;padding-top:24px;display:flex;justify-content:space-between;gap:24px;color:var(--color-slate-500);font-size:.8125rem}
    </style>
    {block head}{/block}
</head>
<body>
    <header class="site-header">
        <div class="nav-row">
            <a class="brand" href="/"><img src="/assets/logo_transparent.png" alt="Sowing.me"><span>Sowing.me</span></a>
            <nav class="links">
                <a href="/for-creators"{if ($activeNav ?? '') === 'for-creators'} aria-current="page"{/if}>For Creators</a>
                <a href="/how-it-works"{if ($activeNav ?? '') === 'how-it-works'} aria-current="page"{/if}>How It Works</a>
                <a href="#">Explore</a>
                <a href="/pricing"{if ($activeNav ?? '') === 'pricing'} aria-current="page"{/if}>Pricing</a>
            </nav>
            <div class="nav-actions">
                <a href="/login" class="nav-login">Log In</a>
                {if !($hideSignup ?? false)}<a href="/signup" class="nav-signup">Sign Up</a>{/if}
            </div>
        </div>
    </header>

    {block content}{/block}

    {if !($noFooter ?? false)}
    <footer class="site-footer">
        <div class="wrap">
            <div class="f-top">
                <div>
                    <div class="f-brand"><img src="/assets/logo_transparent.png" style="height:34px;width:34px;object-fit:contain" alt=""><span>Sowing.me</span></div>
                    <p class="f-blurb">Planting. Believing. Thriving. Membership tools for Christian creators.</p>
                </div>
                <div>
                    <h4>Platform</h4>
                    <a href="/for-creators">For Creators</a>
                    <a href="/how-it-works">How It Works</a>
                    <a href="/pricing">Pricing</a>
                </div>
                <div>
                    <h4>Company</h4>
                    <a href="/about">About</a>
                    <a href="#">Explore</a>
                    <a href="#">Contact</a>
                </div>
                <div>
                    <h4>Legal</h4>
                    <a href="#">Terms of Service</a>
                    <a href="#">Privacy Policy</a>
                </div>
            </div>
            <div class="f-bottom">
                <span>&copy; 2026 Sowing.me. All rights reserved.</span>
                <span>Made for creators who sow.</span>
            </div>
        </div>
    </footer>
    {/if}

    <script>const h=document.querySelector(".site-header");addEventListener("scroll",()=>h.toggleAttribute("data-scrolled",scrollY>4),{passive:true});</script>
    {block scripts}{/block}
</body>
</html>
