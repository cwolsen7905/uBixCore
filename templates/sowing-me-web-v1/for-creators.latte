{extends 'layout.latte'}

{var $activeNav = 'for-creators'}

{block title}For Creators{/block}

{block head}
<style n:syntax="off">
  .cta-grid{display:flex;align-items:flex-end;justify-content:space-between;gap:48px}
  .split{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center;padding:88px 0}
  .split+.split{border-top:1px solid var(--color-slate-100)}
  .split.flip .split-copy{order:2}
  .split-h{font-size:2rem;margin:14px 0 14px}
  .split-media{aspect-ratio:4/3}
  .earn{display:grid;grid-template-columns:repeat(3,1fr)}
  .earn-item{padding:36px 32px;border-left:1px solid var(--color-slate-100)}
  .earn-item:first-child{border-left:0}
  .earn-n{font-family:var(--font-heading);font-size:2.5rem;font-weight:800;letter-spacing:-.035em;line-height:1;color:var(--color-text)}
  .earn-l{margin-top:10px;font-family:var(--font-heading);font-size:.8125rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--color-text-subtle)}
</style>
{/block}

{block content}
{* NOTE: "Keep up to 92%" and the $460/$920/$4,600 earnings figures are PLACEHOLDER
   copy from the design handoff (assume $10/member less 8% Starter fee) — verify before promoting past dev. *}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">For creators</span>
    <h1 class="h1">Turn your calling into a ministry that supports itself.</h1>
    <p class="lede">Memberships, publishing, and payouts built for faith-led creators — so the work is funded by the people it serves.</p>
    <div class="btn-row">
      <a href="/signup" class="btn btn-primary">Start your page</a>
      <a href="/pricing" class="btn btn-ghost">See pricing</a>
    </div>
  </div>
</section>

<section>
  <div class="wrap split">
    <div class="split-copy">
      <span class="eyebrow">Income</span>
      <h3 class="h2 split-h">Earn predictable income.</h3>
      <p class="lede">Stop depending on ad revenue and one-off appeals. Recurring memberships give you a number you can plan around.</p>
      <ul class="checks"><li><svg viewBox="0 0 24 24"><path d="M4 12l5 5 11-11"/></svg>Monthly recurring support from members</li><li><svg viewBox="0 0 24 24"><path d="M4 12l5 5 11-11"/></svg>Up to five membership tiers</li><li><svg viewBox="0 0 24 24"><path d="M4 12l5 5 11-11"/></svg>Keep up to 92% of what you earn</li><li><svg viewBox="0 0 24 24"><path d="M4 12l5 5 11-11"/></svg>Weekly payouts to your bank account</li></ul>
    </div>
    <div class="frame split-media"><div class="img-ph">Earnings dashboard — 4:3</div></div>
  </div>

  <div class="wrap split flip">
    <div class="split-copy">
      <span class="eyebrow">Community</span>
      <h3 class="h2 split-h">Build real community.</h3>
      <p class="lede">Your supporters are not an audience metric. Talk to them, pray with them, and let them into the work.</p>
      <ul class="checks"><li><svg viewBox="0 0 24 24"><path d="M4 12l5 5 11-11"/></svg>Direct messaging with supporters</li><li><svg viewBox="0 0 24 24"><path d="M4 12l5 5 11-11"/></svg>Members-only posts and media</li><li><svg viewBox="0 0 24 24"><path d="M4 12l5 5 11-11"/></svg>Polls, discussions, and prayer threads</li><li><svg viewBox="0 0 24 24"><path d="M4 12l5 5 11-11"/></svg>Member-only live streams</li></ul>
    </div>
    <div class="frame split-media"><div class="img-ph">Community feed — 4:3</div></div>
  </div>

  <div class="wrap split">
    <div class="split-copy">
      <span class="eyebrow">Focus</span>
      <h3 class="h2 split-h">Spend your time on the work.</h3>
      <p class="lede">The admin runs itself, so your week goes back to teaching, writing, and recording.</p>
      <ul class="checks"><li><svg viewBox="0 0 24 24"><path d="M4 12l5 5 11-11"/></svg>Simple creator dashboard</li><li><svg viewBox="0 0 24 24"><path d="M4 12l5 5 11-11"/></svg>Audience analytics that explain themselves</li><li><svg viewBox="0 0 24 24"><path d="M4 12l5 5 11-11"/></svg>Share pages and promo tools</li><li><svg viewBox="0 0 24 24"><path d="M4 12l5 5 11-11"/></svg>No demonetization for faith-based messaging</li></ul>
    </div>
    <div class="frame split-media"><div class="img-ph">Creator dashboard — 4:3</div></div>
  </div>
</section>

<section class="section tint">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Who it's for</span>
      <h2 class="h2">Built for every kind of Christian creator.</h2>
      <p class="lede">Whatever form your ministry takes, the tools are the same.</p>
    </div>
    <div class="grid-3" style="margin-top:52px">
      <div class="card">
        <div class="icon-tile"><svg viewBox="0 0 24 24"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0M12 17v4M9 21h6"/></svg></div>
        <h3 class="h3">Podcasters</h3>
        <p>Devotionals, interviews, and teaching series, with bonus episodes for members.</p>
      </div>
      <div class="card">
        <div class="icon-tile"><svg viewBox="0 0 24 24"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg></div>
        <h3 class="h3">Musicians &amp; worship leaders</h3>
        <p>Release worship music, chord charts, and behind-the-scenes sessions.</p>
      </div>
      <div class="card">
        <div class="icon-tile"><svg viewBox="0 0 24 24"><rect x="2" y="6" width="15" height="12" rx="2"/><path d="M17 10l5-3v10l-5-3"/></svg></div>
        <h3 class="h3">Video creators</h3>
        <p>Bible studies, vlogs, and teaching video with early access for supporters.</p>
      </div>
      <div class="card">
        <div class="icon-tile"><svg viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></div>
        <h3 class="h3">Writers &amp; bloggers</h3>
        <p>Devotionals, essays, and books-in-progress for the readers who follow closest.</p>
      </div>
      <div class="card">
        <div class="icon-tile"><svg viewBox="0 0 24 24"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/><path d="M12 2a10 10 0 1 0 10 10c0-1-.5-2-2-2h-3a2 2 0 0 1-2-2 2 2 0 0 1 2-2c1 0 2-.5 2-2 0-2-3-2-7-2z"/></svg></div>
        <h3 class="h3">Artists &amp; designers</h3>
        <p>Faith-inspired art, printables, and process work for your collectors.</p>
      </div>
      <div class="card">
        <div class="icon-tile"><svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></div>
        <h3 class="h3">Teachers &amp; coaches</h3>
        <p>Courses, cohorts, and mentorship for people growing in their faith.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Earning potential</span>
      <h2 class="h2">What monthly support adds up to.</h2>
      <p class="lede">At an average of $10 per member per month, after the 8% Starter platform fee.</p>
    </div>
    <div class="panel earn" style="margin-top:44px">
      <div class="earn-item"><div class="earn-n">$460</div><div class="earn-l">50 members</div></div>
      <div class="earn-item"><div class="earn-n">$920</div><div class="earn-l">100 members</div></div>
      <div class="earn-item"><div class="earn-n">$4,600</div><div class="earn-l">500 members</div></div>
    </div>
    <p class="small" style="margin-top:20px">Illustrative only. Actual earnings depend on your tier pricing and payment processing fees. <a href="/pricing" class="arrow-link">See the full fee breakdown<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6"/></svg></a></p>
  </div>
</section>

<section class="cta-band">
  <div class="wrap cta-grid">
    <div>
      <h2 class="h2">Start growing your ministry today.</h2>
      <p style="margin-top:14px">Setting up your page is free and takes about an afternoon.</p>
    </div>
    <div class="btn-row">
      <a href="/signup" class="btn btn-light">Create your free page</a>
      <a href="/how-it-works" class="btn btn-onDark">How it works</a>
    </div>
  </div>
</section>
{/block}
