{extends 'layout.latte'}

{block title}How It Works{/block}

{block head}
<style>
    .hiw-hero {
        background: var(--color-secondary);
        color: var(--color-white);
        padding: 80px 0;
        text-align: center;
    }

    .hiw-hero h1 {
        font-size: 3rem;
        margin-bottom: 20px;
    }

    .hiw-hero p {
        font-size: 1.2rem;
        opacity: 0.92;
        margin-bottom: 0;
    }

    .for-creators, .for-supporters {
        padding: 96px 0;
    }

    .for-supporters {
        background: var(--color-surface-2);
    }

    .steps-detailed {
        margin-top: 56px;
    }

    .step-detailed {
        display: grid;
        grid-template-columns: 90px 1fr;
        gap: 28px;
        margin-bottom: 48px;
        align-items: start;
    }

    .step-number-large {
        width: 74px;
        height: 74px;
        border-radius: 50%;
        background: var(--color-primary);
        color: var(--color-white);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-heading);
        font-size: 1.75rem;
        font-weight: 800;
        flex-shrink: 0;
    }

    .for-supporters .step-number-large {
        background: var(--color-secondary);
    }

    .step-content h3 {
        font-size: 1.375rem;
        margin-bottom: 10px;
    }

    .step-content p {
        color: var(--color-text-muted);
        margin-bottom: 8px;
    }

    .step-content ul {
        list-style: none;
        padding: 0;
        margin-top: 12px;
        margin-bottom: 0;
    }

    .step-content li {
        padding: 6px 0 6px 22px;
        position: relative;
        color: var(--color-text-muted);
        font-size: 0.9rem;
    }

    .step-content li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 14px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--color-primary);
    }

    .for-supporters .step-content li::before {
        background: var(--color-secondary);
    }

    .features-section {
        padding: 100px 0;
    }

    .features-list {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 36px;
        margin-top: 60px;
    }

    .feature-item {
        display: flex;
        gap: 18px;
    }

    .feature-item-icon {
        width: 44px;
        height: 44px;
        border-radius: var(--radius-md);
        background: var(--color-primary-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .feature-item-icon svg {
        width: 22px;
        height: 22px;
        stroke: var(--color-primary);
    }

    .feature-item h4 {
        margin-bottom: 8px;
    }

    .feature-item p {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        margin-bottom: 0;
    }

    .cta-hiw {
        background: var(--color-primary);
        color: var(--color-white);
        padding: 80px 0;
        text-align: center;
    }

    .cta-hiw h2 {
        margin-bottom: 20px;
        color: var(--color-white);
    }

    .cta-hiw p {
        margin-bottom: 30px;
        opacity: 0.92;
    }

    .cta-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    @media (max-width: 768px) {
        .step-detailed {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .step-number-large {
            margin: 0 auto;
        }

        .feature-item {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
    }
</style>
{/block}

{block content}
<section class="hiw-hero">
    <div class="container">
        <h1>How Sowing.me Works</h1>
        <p>Whether you're a creator or a supporter, getting started is easy</p>
    </div>
</section>

<section class="for-creators">
    <div class="container">
        <h2 class="section-title text-center">For Creators</h2>
        <p class="section-subtitle text-center">Launch your creator page in minutes</p>

        <div class="steps-detailed">
            <div class="step-detailed">
                <div class="step-number-large">1</div>
                <div class="step-content">
                    <h3>Create Your Page</h3>
                    <p>Sign up for free and set up your creator profile. Tell your story, share your mission, and let people know what you're creating.</p>
                    <ul>
                        <li>Add your bio and profile photo</li>
                        <li>Describe your ministry and content</li>
                        <li>Connect your social media accounts</li>
                    </ul>
                </div>
            </div>

            <div class="step-detailed">
                <div class="step-number-large">2</div>
                <div class="step-content">
                    <h3>Set Up Membership Tiers</h3>
                    <p>Create membership levels with different price points and benefits. Give supporters options that fit their budget.</p>
                    <ul>
                        <li>Create 1-5 membership tiers</li>
                        <li>Set monthly prices ($1-$100+)</li>
                        <li>Define exclusive benefits for each tier</li>
                    </ul>
                </div>
            </div>

            <div class="step-detailed">
                <div class="step-number-large">3</div>
                <div class="step-content">
                    <h3>Share Your Content</h3>
                    <p>Post content for your supporters. Mix free public posts with exclusive member-only content.</p>
                    <ul>
                        <li>Upload videos, audio, images, and text</li>
                        <li>Schedule posts in advance</li>
                        <li>Create tier-specific exclusive content</li>
                    </ul>
                </div>
            </div>

            <div class="step-detailed">
                <div class="step-number-large">4</div>
                <div class="step-content">
                    <h3>Grow & Get Paid</h3>
                    <p>Promote your page, grow your community, and receive monthly payments directly to your bank account.</p>
                    <ul>
                        <li>Share your page link everywhere</li>
                        <li>Track growth with analytics</li>
                        <li>Receive weekly or monthly payouts</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="for-supporters">
    <div class="container">
        <h2 class="section-title text-center">For Supporters</h2>
        <p class="section-subtitle text-center">Support the creators you love</p>

        <div class="steps-detailed">
            <div class="step-detailed">
                <div class="step-number-large">1</div>
                <div class="step-content">
                    <h3>Find Creators You Love</h3>
                    <p>Discover Christian creators who inspire you—podcasters, musicians, teachers, artists, and more.</p>
                    <ul>
                        <li>Browse by category or search</li>
                        <li>Preview free content before joining</li>
                        <li>Find creators recommended for you</li>
                    </ul>
                </div>
            </div>

            <div class="step-detailed">
                <div class="step-number-large">2</div>
                <div class="step-content">
                    <h3>Choose Your Support Level</h3>
                    <p>Pick a membership tier that fits your budget and unlocks the benefits you want.</p>
                    <ul>
                        <li>See all available tiers and benefits</li>
                        <li>Support for as little as $1/month</li>
                        <li>Cancel or change tiers anytime</li>
                    </ul>
                </div>
            </div>

            <div class="step-detailed">
                <div class="step-number-large">3</div>
                <div class="step-content">
                    <h3>Enjoy Exclusive Content</h3>
                    <p>Get access to member-only posts, early releases, behind-the-scenes content, and more.</p>
                    <ul>
                        <li>Access exclusive posts and media</li>
                        <li>Join member-only live streams</li>
                        <li>Connect directly with creators</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="features-section">
    <div class="container">
        <h2 class="section-title text-center">Platform Features</h2>
        <p class="section-subtitle text-center">Everything you need to create and support</p>

        <div class="features-list">
            <div class="feature-item">
                <div class="feature-item-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg></div>
                <div>
                    <h4>Mobile-Friendly</h4>
                    <p>Access Sowing.me from any device. Create and consume content on the go.</p>
                </div>
            </div>

            <div class="feature-item">
                <div class="feature-item-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></div>
                <div>
                    <h4>Notifications</h4>
                    <p>Never miss a post from your favorite creators with email and push notifications.</p>
                </div>
            </div>

            <div class="feature-item">
                <div class="feature-item-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
                <div>
                    <h4>Direct Messaging</h4>
                    <p>Creators can message their supporters directly for a personal touch.</p>
                </div>
            </div>

            <div class="feature-item">
                <div class="feature-item-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12" y="8" width="3" height="10"/><rect x="17" y="5" width="3" height="13"/></svg></div>
                <div>
                    <h4>Analytics Dashboard</h4>
                    <p>Track your growth, see what content performs best, and understand your audience.</p>
                </div>
            </div>

            <div class="feature-item">
                <div class="feature-item-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></div>
                <div>
                    <h4>Secure Payments</h4>
                    <p>Industry-standard encryption protects all payment information.</p>
                </div>
            </div>

            <div class="feature-item">
                <div class="feature-item-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v9H4v-9M2 7h20v5H2zM12 7v14M12 7c-1.5-3-6-3-6-.5S9 7 12 7zM12 7c1.5-3 6-3 6-.5S15 7 12 7z"/></svg></div>
                <div>
                    <h4>Special Offers</h4>
                    <p>Create limited-time discounts and promotions to attract new supporters.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-hiw">
    <div class="container">
        <h2>Ready to Get Started?</h2>
        <p>Join the Sowing.me community today</p>
        <div class="cta-buttons">
            <a href="/signup" class="btn btn-accent">Start Creating</a>
            <a href="/pricing" class="btn" style="background: white; color: var(--color-primary);">View Pricing</a>
        </div>
    </div>
</section>
{/block}
