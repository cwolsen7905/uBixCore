{extends 'layout.latte'}

{var $activeNav = 'how-it-works'}

{block title}How It Works{/block}

{block head}
<style n:syntax="off">
  .cta-grid{display:flex;align-items:flex-end;justify-content:space-between;gap:48px}
  .step-card{display:flex;flex-direction:column}
  .step-n{font-family:var(--font-heading);font-size:.8125rem;font-weight:700;letter-spacing:.1em;color:var(--color-primary);margin-bottom:14px}
  .step-n.blue{color:var(--color-secondary)}
  ul.dots{list-style:none;padding:0;margin:16px 0 0}
  ul.dots li{position:relative;padding:5px 0 5px 18px;font-size:.875rem;color:var(--color-text-muted)}
  ul.dots li::before{content:"";position:absolute;left:0;top:13px;width:5px;height:5px;border-radius:50%;background:var(--color-primary)}
  ul.dots.blue li::before{background:var(--color-secondary)}
  .feats{display:grid;grid-template-columns:repeat(3,1fr);gap:36px 40px;margin-top:52px}
  .feat{display:flex;gap:18px;align-items:flex-start}
</style>
{/block}

{block content}
<section class="page-hero">
  <div class="wrap">
    <span class="eyebrow">How it works</span>
    <h1 class="h1">Two sides, one simple idea.</h1>
    <p class="lede">Creators publish the work they are called to. Supporters sow into it every month. Here is what that looks like from both seats.</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">For creators</span>
      <h2 class="h2">Launch your page in an afternoon.</h2>
    </div>
    <div class="grid-2" style="margin-top:52px">
      <div class="card step-card">
        <div class="step-n">01</div>
        <h3 class="h3">Create your page</h3>
        <p>Sign up free and set up your profile. Tell your story, share your mission, and say what you are making.</p>
        <ul class="dots"><li>Add your bio and profile photo</li><li>Describe your ministry and content</li><li>Connect your social accounts</li></ul>
      </div>
      <div class="card step-card">
        <div class="step-n">02</div>
        <h3 class="h3">Set up membership tiers</h3>
        <p>Build levels at different price points so supporters can give at a level that fits.</p>
        <ul class="dots"><li>Create one to five tiers</li><li>Set monthly prices from $1 to $100+</li><li>Define the benefits of each tier</li></ul>
      </div>
      <div class="card step-card">
        <div class="step-n">03</div>
        <h3 class="h3">Share your content</h3>
        <p>Publish for your members. Mix free public posts with member-only work.</p>
        <ul class="dots"><li>Upload video, audio, images, and writing</li><li>Schedule posts in advance</li><li>Gate content by tier</li></ul>
      </div>
      <div class="card step-card">
        <div class="step-n">04</div>
        <h3 class="h3">Grow and get paid</h3>
        <p>Promote your page, watch the community grow, and receive payouts on your schedule.</p>
        <ul class="dots"><li>Share your page link anywhere</li><li>Track growth with analytics</li><li>Weekly or monthly payouts</li></ul>
      </div>
    </div>
  </div>
</section>

<section class="section tint">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow" style="color:var(--color-secondary)">For supporters</span>
      <h2 class="h2">Sow into the work you believe in.</h2>
    </div>
    <div class="grid-3" style="margin-top:52px">
      <div class="card step-card">
        <div class="step-n blue">01</div>
        <h3 class="h3">Find creators you love</h3>
        <p>Discover Christian podcasters, musicians, teachers, and artists worth following.</p>
        <ul class="dots blue"><li>Browse by category or search</li><li>Preview free content first</li><li>See recommendations for you</li></ul>
      </div>
      <div class="card step-card">
        <div class="step-n blue">02</div>
        <h3 class="h3">Choose your support level</h3>
        <p>Pick the tier that fits your budget and unlocks what you actually want.</p>
        <ul class="dots blue"><li>Compare tiers and benefits</li><li>Support from $1 a month</li><li>Change or cancel anytime</li></ul>
      </div>
      <div class="card step-card">
        <div class="step-n blue">03</div>
        <h3 class="h3">Enjoy exclusive content</h3>
        <p>Member-only posts, early releases, and a direct line to the creator.</p>
        <ul class="dots blue"><li>Exclusive posts and media</li><li>Member-only live streams</li><li>Message the creator directly</li></ul>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Platform</span>
      <h2 class="h2">Everything runs on the same rails.</h2>
      <p class="lede">The details that make the platform feel finished on both sides.</p>
    </div>
    <div class="feats">
      <div class="feat">
        <div class="icon-tile" style="margin-bottom:0"><svg viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/></svg></div>
        <div><h4 class="h3">Mobile-friendly</h4><p class="small" style="margin-top:6px">Create and read on any device, with a layout built for phones first.</p></div>
      </div>
      <div class="feat">
        <div class="icon-tile" style="margin-bottom:0"><svg viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></div>
        <div><h4 class="h3">Notifications</h4><p class="small" style="margin-top:6px">Email and push alerts so no post goes unseen.</p></div>
      </div>
      <div class="feat">
        <div class="icon-tile" style="margin-bottom:0"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></div>
        <div><h4 class="h3">Direct messaging</h4><p class="small" style="margin-top:6px">Creators can write to members one-to-one or in groups.</p></div>
      </div>
      <div class="feat">
        <div class="icon-tile" style="margin-bottom:0"><svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12" y="8" width="3" height="10"/><rect x="17" y="5" width="3" height="13"/></svg></div>
        <div><h4 class="h3">Analytics</h4><p class="small" style="margin-top:6px">See what performs, where members come from, and who is at risk of churning.</p></div>
      </div>
      <div class="feat">
        <div class="icon-tile" style="margin-bottom:0"><svg viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></div>
        <div><h4 class="h3">Secure payments</h4><p class="small" style="margin-top:6px">PCI-compliant processing and encryption on every transaction.</p></div>
      </div>
      <div class="feat">
        <div class="icon-tile" style="margin-bottom:0"><svg viewBox="0 0 24 24"><path d="M20 12v9H4v-9M2 7h20v5H2zM12 7v14M12 7c-1.5-3-6-3-6-.5S9 7 12 7zM12 7c1.5-3 6-3 6-.5S15 7 12 7z"/></svg></div>
        <div><h4 class="h3">Offers and promos</h4><p class="small" style="margin-top:6px">Run limited-time discounts to bring new supporters in.</p></div>
      </div>
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="wrap cta-grid">
    <div>
      <h2 class="h2">Ready to get started?</h2>
      <p style="margin-top:14px">Create your page free, or find a creator to support today.</p>
    </div>
    <div class="btn-row">
      <a href="/signup" class="btn btn-light">Start creating</a>
      <a href="/pricing" class="btn btn-onDark">See pricing</a>
    </div>
  </div>
</section>
{/block}
