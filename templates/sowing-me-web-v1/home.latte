{extends 'layout.latte'}

{block title}Home{/block}

{block head}
<style>
    .hero {
        background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
        color: var(--color-white);
        padding: 100px 0;
        text-align: center;
    }

    .hero h1 {
        font-size: 3.5rem;
        margin-bottom: 20px;
    }

    .hero .tagline {
        font-size: 1.5rem;
        font-weight: 600;
        opacity: 0.92;
        margin-bottom: 30px;
    }

    .hero p.sub {
        font-size: 1.2rem;
        max-width: 620px;
        margin: 0 auto 40px;
        opacity: 0.92;
    }

    .hero-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .hero .btn {
        padding: 16px 32px;
        font-size: 1.1rem;
    }

    .features {
        padding: 100px 0;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 32px;
        margin-top: 60px;
    }

    .feature-card {
        text-align: center;
        padding: 40px 28px;
        border-radius: var(--radius-lg);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        box-shadow: var(--shadow-card);
        transition: transform 0.3s;
    }

    .feature-card:hover {
        transform: translateY(-5px);
    }

    .feature-icon {
        width: 64px;
        height: 64px;
        border-radius: var(--radius-full);
        background: var(--color-primary-soft);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }

    .feature-icon svg {
        width: 30px;
        height: 30px;
        stroke: var(--color-primary);
    }

    .feature-card h3 {
        margin-bottom: 15px;
        color: var(--color-primary);
        font-size: 1.15rem;
    }

    .feature-card p {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        margin-bottom: 0;
    }

    .how-it-works-preview {
        background: var(--color-surface-2);
        padding: 100px 0;
    }

    .steps {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
        margin-top: 60px;
    }

    .step {
        text-align: center;
        padding: 30px;
    }

    .step-number {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: var(--color-primary);
        color: var(--color-white);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-heading);
        font-size: 1.5rem;
        font-weight: 800;
        margin: 0 auto 20px;
    }

    .step h3 {
        margin-bottom: 10px;
    }

    .step p {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        margin-bottom: 0;
    }

    .cta-section {
        background: var(--color-secondary);
        color: var(--color-white);
        padding: 80px 0;
        text-align: center;
    }

    .cta-section h2 {
        margin-bottom: 20px;
        color: var(--color-white);
    }

    .cta-section p {
        margin-bottom: 30px;
        opacity: 0.92;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .stats {
        padding: 80px 0;
        background: var(--color-white);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 40px;
        text-align: center;
    }

    .stat-item h3 {
        font-size: 3rem;
        color: var(--color-primary);
        margin-bottom: 10px;
    }

    .stat-item p {
        color: var(--color-text-muted);
        font-weight: 600;
        margin-bottom: 0;
    }

    @media (max-width: 768px) {
        .hero h1 {
            font-size: 2.5rem;
        }

        .hero .tagline {
            font-size: 1.2rem;
        }

        .features-grid,
        .steps,
        .stats-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
{/block}

{block content}
<section class="hero">
    <div class="container">
        <h1>Support Christian Creators</h1>
        <p class="tagline">Planting. Believing. Thriving.</p>
        <p class="sub">Sowing.me empowers faith-based creators to share their gifts while building a community of supporters who believe in their mission.</p>
        <div class="hero-buttons">
            <a href="/for-creators" class="btn btn-accent">Start Creating</a>
            <a href="/how-it-works" class="btn btn-outline" style="border-color: white; color: white;">Learn More</a>
        </div>
    </div>
</section>

<section class="features">
    <div class="container">
        <h2 class="section-title text-center">Why Choose Sowing.me?</h2>
        <p class="section-subtitle text-center">A platform built on faith, designed for growth</p>

        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12M12 12C12 8 9 5 5 5c0 4 3 7 7 7zM12 12c0-4 3-7 7-7 0 4-3 7-7 7z"/></svg>
                </div>
                <h3>Faith-Centered Community</h3>
                <p>Connect with supporters who share your values and understand your mission to spread faith through content.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9 9.5c0-1.4 1.3-2.5 3-2.5s3 1 3 2.3c0 3-6 1.5-6 4.5 0 1.4 1.3 2.5 3 2.5s3-1.1 3-2.5"/></svg>
                </div>
                <h3>Sustainable Income</h3>
                <p>Build a reliable income stream through monthly memberships, allowing you to focus on creating meaningful content.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 20v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1"/><circle cx="9" cy="7" r="4"/><path d="M23 20v-1a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></svg>
                </div>
                <h3>Direct Connection</h3>
                <p>Engage directly with your supporters through exclusive content, messages, and community features.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg>
                </div>
                <h3>Growth Tools</h3>
                <p>Access analytics, promotional tools, and resources to help you grow your audience and increase your impact.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                </div>
                <h3>Creator-Friendly Terms</h3>
                <p>Keep more of what you earn with competitive rates and transparent pricing. No hidden fees.</p>
            </div>

            <div class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v6M12 22v-8M8 6l4-4 4 4M6 14h12l-1 8H7z"/></svg>
                </div>
                <h3>Aligned Values</h3>
                <p>A platform that respects and supports Christian content creators without censorship of faith-based messaging.</p>
            </div>
        </div>
    </div>
</section>

<section class="how-it-works-preview">
    <div class="container">
        <h2 class="section-title text-center">How It Works</h2>
        <p class="section-subtitle text-center">Get started in three simple steps</p>

        <div class="steps">
            <div class="step">
                <div class="step-number">1</div>
                <h3>Create Your Page</h3>
                <p>Set up your creator profile, describe your mission, and define membership tiers with exclusive benefits.</p>
            </div>

            <div class="step">
                <div class="step-number">2</div>
                <h3>Share Your Content</h3>
                <p>Post videos, podcasts, articles, or any content that inspires your community and shares your message.</p>
            </div>

            <div class="step">
                <div class="step-number">3</div>
                <h3>Grow & Thrive</h3>
                <p>Build your supporter base, receive monthly income, and focus on what matters most—your ministry.</p>
            </div>
        </div>

        <div class="text-center" style="margin-top: 40px;">
            <a href="/how-it-works" class="btn btn-primary">Learn More</a>
        </div>
    </div>
</section>

<section class="stats">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-item">
                <h3>1000+</h3>
                <p>Active Creators</p>
            </div>
            <div class="stat-item">
                <h3>50K+</h3>
                <p>Monthly Supporters</p>
            </div>
            <div class="stat-item">
                <h3>$2M+</h3>
                <p>Paid to Creators</p>
            </div>
            <div class="stat-item">
                <h3>95%</h3>
                <p>Creator Satisfaction</p>
            </div>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container">
        <h2>Ready to Start Your Journey?</h2>
        <p>Join thousands of Christian creators who are building sustainable ministries through Sowing.me.</p>
        <a href="/signup" class="btn btn-accent">Get Started Free</a>
    </div>
</section>
{/block}
