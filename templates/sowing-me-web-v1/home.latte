{extends 'layout.latte'}

{block title}Home{/block}

{block head}
<style>
  .hero{background:linear-gradient(180deg,#F2F7F2 0%,#fff 70%);padding:96px 0 88px}
  .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:64px;align-items:center}
  .hero .display{margin:18px 0 22px}
  .hero .lede{max-width:470px}
  .hero .btn-row{margin:34px 0 18px}
  .hero-media{aspect-ratio:4/3}
  .proof{border-top:1px solid var(--color-slate-100);border-bottom:1px solid var(--color-slate-100)}
  .proof-grid{display:grid;grid-template-columns:repeat(3,1fr);padding:34px 0}
  .proof-item{padding:0 32px;border-left:1px solid var(--color-slate-100)}
  .proof-item:first-child{border-left:0;padding-left:0}
  .proof-n{font-family:var(--font-heading);font-size:1.75rem;font-weight:800;letter-spacing:-.03em;color:var(--color-text);line-height:1.1}
  .steps{margin-top:36px;display:grid;gap:2px}
  .step{display:grid;grid-template-columns:44px 1fr;gap:18px;padding:24px 0;border-top:1px solid var(--color-slate-200)}
  .step:last-child{border-bottom:1px solid var(--color-slate-200)}
  .step-n{font-family:var(--font-heading);font-size:.8125rem;font-weight:700;letter-spacing:.1em;color:var(--color-primary);padding-top:4px}
  .step p{color:var(--color-text-muted);font-size:.9375rem;margin-top:6px}
  .how-grid{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center}
  .how-media{aspect-ratio:3/4}
  .quote{display:grid;grid-template-columns:120px 1fr;gap:44px;align-items:start}
  .quote blockquote{margin:0;font-family:var(--font-heading);font-size:1.875rem;font-weight:600;line-height:1.35;letter-spacing:-.02em;color:#fff}
  .quote cite{display:block;margin-top:22px;font-style:normal;font-size:.9375rem;color:var(--color-slate-400)}
  .cta-grid{display:flex;align-items:flex-end;justify-content:space-between;gap:48px}
</style>
{/block}

{block content}
{* NOTE: proof-strip figures, the Marcus Ellery testimonial, and the "no platform
   fee on your first $1,000" line are PLACEHOLDER copy from the design handoff —
   verify or replace before promoting past dev. *}
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow">For Christian creators</span>
      <h1 class="display">Build a ministry your community sustains.</h1>
      <p class="lede">Sowing.me gives faith-based creators memberships, publishing, and payouts in one place — so support arrives every month instead of every campaign.</p>
      <div class="btn-row">
        <a href="/signup" class="btn btn-primary">Start creating</a>
        <a href="/how-it-works" class="btn btn-ghost">See how it works</a>
      </div>
      <p class="micro">Free to start · No platform fee on your first $1,000</p>
    </div>
    <div class="frame hero-media"><div class="img-ph">Creator page screenshot — 4:3</div></div>
  </div>
</section>

<section class="proof">
  <div class="wrap">
    <div class="proof-grid">
      <div class="proof-item"><div class="proof-n">1,000+</div><p class="small">Creators publishing on Sowing.me</p></div>
      <div class="proof-item"><div class="proof-n">$2M+</div><p class="small">Paid out to creators to date</p></div>
      <div class="proof-item"><div class="proof-n">50,000</div><p class="small">Supporters giving every month</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Why Sowing.me</span>
      <h2 class="h2">A platform that understands the work.</h2>
      <p class="lede">Everything a faith-led creator needs to publish, earn, and stay close to the people who support them.</p>
    </div>
    <div class="grid-3" style="margin-top:56px">
      <div class="card">
        <div class="icon-tile"><svg viewBox="0 0 24 24"><path d="M12 22V12M12 12C12 8 9 5 5 5c0 4 3 7 7 7zM12 12c0-4 3-7 7-7 0 4-3 7-7 7z"/></svg></div>
        <h3 class="h3">Faith-centered community</h3>
        <p>Reach supporters who share your values and already understand the mission behind your content.</p>
      </div>
      <div class="card">
        <div class="icon-tile"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9 9.5c0-1.4 1.3-2.5 3-2.5s3 1 3 2.3c0 3-6 1.5-6 4.5 0 1.4 1.3 2.5 3 2.5s3-1.1 3-2.5"/></svg></div>
        <h3 class="h3">Predictable monthly income</h3>
        <p>Recurring memberships replace one-off appeals, so you can plan a year of ministry instead of a week.</p>
      </div>
      <div class="card">
        <div class="icon-tile"><svg viewBox="0 0 24 24"><path d="M17 20v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1"/><circle cx="9" cy="7" r="4"/><path d="M23 20v-1a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></svg></div>
        <h3 class="h3">Direct connection</h3>
        <p>Members-only posts, messages, and prayer threads keep you in conversation with your supporters.</p>
      </div>
      <div class="card">
        <div class="icon-tile"><svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg></div>
        <h3 class="h3">Growth tools built in</h3>
        <p>Audience analytics, share pages, and email tools show what's working and where to invest next.</p>
      </div>
      <div class="card">
        <div class="icon-tile"><svg viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></div>
        <h3 class="h3">Transparent terms</h3>
        <p>One clear rate, no hidden fees, and your members list is always yours to export.</p>
      </div>
      <div class="card">
        <div class="icon-tile"><svg viewBox="0 0 24 24"><path d="M12 2v6M12 22v-8M8 6l4-4 4 4M6 14h12l-1 8H7z"/></svg></div>
        <h3 class="h3">Aligned values</h3>
        <p>Faith-based messaging is welcome here — no demonetization for preaching what you believe.</p>
      </div>
    </div>
  </div>
</section>

<section class="section tint">
  <div class="wrap how-grid">
    <div>
      <span class="eyebrow">How it works</span>
      <h2 class="h2" style="margin:14px 0 16px">Three steps to your first supporter.</h2>
      <p class="lede">Most creators launch in an afternoon and see their first monthly member the same week.</p>
      <div class="steps">
        <div class="step">
          <div class="step-n">01</div>
          <div>
            <h3 class="h3">Create your page</h3>
            <p>Set up your profile, describe your mission, and define membership tiers with the benefits you want to offer.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-n">02</div>
          <div>
            <h3 class="h3">Share your content</h3>
            <p>Publish videos, teaching series, podcasts, or writing — public to grow, members-only to reward support.</p>
          </div>
        </div>
        <div class="step">
          <div class="step-n">03</div>
          <div>
            <h3 class="h3">Grow and thrive</h3>
            <p>Track your supporter base, receive monthly payouts, and put your time back into the ministry itself.</p>
          </div>
        </div>
      </div>
      <div style="margin-top:32px"><a href="/how-it-works" class="arrow-link">Read the full walkthrough<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6"/></svg></a></div>
    </div>
    <div class="frame how-media"><div class="img-ph">Creator dashboard — 3:4</div></div>
  </div>
</section>

<section class="band section-sm">
  <div class="wrap quote">
    <div style="width:120px;height:120px;border-radius:var(--radius-full);overflow:hidden"><div class="img-ph" style="min-height:0;height:120px">Portrait</div></div>
    <div>
      <blockquote>“I spent years asking for support twice a year. Now 400 people sow into the work every month, and I can plan for the next one.”</blockquote>
      <cite>Marcus Ellery · Bible teaching podcast, 2 years on Sowing.me</cite>
    </div>
  </div>
</section>

<section class="cta-band">
  <div class="wrap cta-grid">
    <div>
      <h2 class="h2">Ready to start your journey?</h2>
      <p style="margin-top:14px">Join the creators building sustainable ministries on Sowing.me. Free to set up, no commitment.</p>
    </div>
    <div class="btn-row">
      <a href="/signup" class="btn btn-light">Get started free</a>
      <a href="/pricing" class="btn btn-onDark">See pricing</a>
    </div>
  </div>
</section>
{/block}
