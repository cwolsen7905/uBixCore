# uBixCore phpstan baseline - include from a project's phpstan.neon:
#
#   includes:
#     - vendor/phpstan/phpstan/conf/bleedingEdge.neon
#     - vendor/ubixsys/ubixcore/php/Ubix/phpstan.neon
#
# Paths here are relative to this file, so the excludes only ever cover
# framework files. The project supplies its own `paths:` and `tmpDir:`.
parameters:
  level: max

  # Pin the analysis target instead of letting PHPStan infer it from the
  # composer constraint. The floor is ^8.5, the base image is php85 and local
  # dev is 8.5.x, so inference happened to be right only by accident -- while
  # the constraint said ^8.3 it was analysing 8.5 code as 8.3.
  phpVersion: 80500

  # Some @phpstan-ignore identifiers (e.g. property.onlyWritten on framework
  # Logger deps) matched under PHP 8.4 but not 8.5, and CI and local dev could
  # differ, so an unmatched ignore must not fail the gate.
  #
  # With phpVersion pinned above that divergence is gone, so this could likely
  # be flipped back to true -- deliberately left alone here, because doing it in
  # the same pass as a floor bump would confuse a real regression with a config
  # change. Worth its own MR.
  reportUnmatchedIgnoredErrors: false

  treatPhpDocTypesAsCertain: false

  excludePaths:
    analyse:
      - Sniffs/**/*.php                               # custom phpcs sniffs are not subject to a full machine code review
      - External/GoogleAuthenticator.php (?)          # temporary until it is spun into its own package
      - Console/Command/App/GenerateOpenapiCommand.php (?) # OpenAPI experiment
      - SlimApp/RecordingApp.php (?)                  # OpenAPI experiment
      - Console/Cron/*.php (?)
