{
	"name": "@ubixsys/ubixcore",
	"version": "0.1.0",
	"description": "uBixCore Svelte 5 component library - the JS half of the uBixCore framework",
	"license": "BSD-3-Clause",
	"repository": {
		"type": "git",
		"url": "git@gitlab.brainchurts.com:ubixsys/ubixcore.git",
		"directory": "js/Ubix"
	},
	"homepage": "https://ubixsys.com",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"publint": "^0.3.2",
		"svelte": "^5.0.0",
		"typescript": "^5.3.2",
		"vite": "^7.0.4"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"ubixcore",
		"ubixsys"
	]
}
