MYSQL_READ_HOST=''
MYSQL_READ_DATABASE=''
MYSQL_READ_USERNAME=''
MYSQL_READ_PASSWORD=''
MYSQL_READ_PORT=3306

MYSQL_WRITE_HOST=''
MYSQL_WRITE_DATABASE=''
MYSQL_WRITE_USERNAME=''
MYSQL_WRITE_PASSWORD=''
MYSQL_WRITE_PORT=3306

MYSQL_MIGRATION_USERNAME=''
MYSQL_MIGRATION_PASSWORD=''

# Preferred: leave every TEST_MYSQL_* below empty and let uBix Vault supply the
# whole unit-test connection. Set VAULT_ADDR plus VAULT_TEST_DB_KV_PATH (a KV v2
# secret carrying host, port, database, username, password) and authenticate with
# a VAULT_TOKEN. Vault is read after this file and wins, so no database password
# needs to exist in a plaintext file on a developer machine.
#
# VAULT_ADDR='https://vault.dev.ubixsys.com'
# VAULT_TEST_DB_KV_PATH='ubixcore/test-db'
# VAULT_TOKEN='' # keep this out of the file: export it, or read it from your keychain
#
# The values below are the fallback for a machine with no Vault access.
TEST_MYSQL_READ_HOST=''
TEST_MYSQL_READ_DATABASE=''
TEST_MYSQL_READ_USERNAME=''
TEST_MYSQL_READ_PASSWORD=''
TEST_MYSQL_READ_PORT=30306

TEST_MYSQL_WRITE_HOST=''
TEST_MYSQL_WRITE_DATABASE=''
TEST_MYSQL_WRITE_USERNAME=''
TEST_MYSQL_WRITE_PASSWORD=''
TEST_MYSQL_WRITE_PORT=30306

MEMCACHE_SERVERS=''

SLACK_API_ENDPOINT=''

SQLITE_DATABASE_PATH='./db'

IS_SANDBOX='true'
IS_DEV='true'
IS_STAGING='false'

LATTE_CACHE_DIRECTORY='/tmp/cache/latte/'
LATTE_TEMPLATES_DIRECTORY='templates/'

LOGGER_PATH='../log'
LOG_LEVEL='debug' # possible values: debug, info, notice, warning, error, critical, alert, emergency

# Authentication hardening (M1-01)
APP_URL='http://127.0.0.1:5173'
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
CORS_ALLOWED_ORIGINS='http://127.0.0.1:5173,http://localhost:5173'
